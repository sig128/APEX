# Copy this file to `.env` in this folder (same directory as `package.json`).
# Vite loads `frontend/.env` — restart `npm run dev` after changes.
#
# These values are your Firebase *web app* config (Client SDK). They are bundled
# into the browser build. Restrict the API key in Firebase Console → App settings.
#
# Do NOT put Service Account / Admin SDK JSON here — that file is for backend/server
# only and must stay private (never commit it).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Optional: local dev only — password for “Admin login” on /login (bundled into client; use for testing).
# VITE_ADMIN_DEV_PASSWORD=

# Optional: chat API base URL (no trailing slash).
# - Local Vite: leave unset (proxies /api to backend on :8787).
# - Production: REQUIRED for reliable long ANALYZE streams. Set in `.env.production` to your
#   Cloud Function URL, e.g. https://us-central1-PROJECT_ID.cloudfunctions.net/chat
#   Then run `npm run build` in frontend/ (loads `.env.production`) before `firebase deploy`.
#   If VITE_API_BASE is missing from the built bundle, the app calls /api/chat on Hosting and
#   streams stop mid-response (~60s Hosting limit on function rewrites).
# VITE_API_BASE=https://us-central1-your-project.cloudfunctions.net/chat

# Optional: public site URL (no trailing slash). Used for og:image and twitter:image absolute URLs when
# sharing links. Set in `.env.production` to your Firebase Hosting URL or custom domain, e.g.
# https://your-project.web.app
# VITE_PUBLIC_SITE_URL=https://your-project.web.app
