# Copy to frontend/.env for `npm run dev`, and to frontend/.env.production for `npm run build`.
# Everything here ends up in the browser bundle: no secrets.

# Firebase web app config (Firebase Console > Project settings > Your apps). Restrict the API
# key to your domains in Google Cloud Console.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Live updates and AI replies stream for minutes, longer than Firebase Hosting allows, so in
# production point them straight at the Cloud Function (leave unset for local dev):
# VITE_API_BASE=https://us-central1-YOUR_PROJECT.cloudfunctions.net/chat
# Regular data requests stay on your domain (/api through Hosting and its CDN). Only set this
# if the API lives somewhere else entirely:
# VITE_DATA_BASE=

# Optional: Privy app id for "Pay with Privy" (email/Google sign-in with a self-custodial wallet).
# Without it, people pay from a browser wallet or by sending USDC from anywhere.
# VITE_PRIVY_APP_ID=

# Your public URL (share links and social previews), e.g. https://apex-picks.web.app
# VITE_PUBLIC_SITE_URL=
