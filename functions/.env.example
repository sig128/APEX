# Copy to functions/.env (git-ignored). The Firebase CLI loads it on deploy.
# Secrets do NOT go here: use `firebase functions:secrets:set` for ANTHROPIC_API_KEY,
# ADMIN_SPORTS_KEY and THE_ODDS_API_KEY.

# ---- passes (USDC on Base) -------------------------------------------------------------------
# Your wallet on Base that receives payments. Leave empty to keep the paywall off.
APEX_TREASURY_ADDRESS=
# base (real money) or base-sepolia (test USDC)
APEX_BILLING_NETWORK=base
# Optional: your own RPC (Alchemy, QuickNode...). Defaults to the public Base endpoint.
# APEX_BASE_RPC_URL=
# APEX_PRICE_PRO_USD=29
# APEX_PRICE_ELITE_USD=79
# Daily AI allowances
# APEX_PRO_AI_READS_PER_DAY=15
# APEX_ELITE_AI_READS_PER_DAY=30
# APEX_PRO_ANALYSES_PER_DAY=8
# APEX_ELITE_ANALYSES_PER_DAY=15
# APEX_USAGE_TZ=America/New_York

# ---- admins ------------------------------------------------------------------------------------
# Google accounts (verified emails) that get the admin page, comps and every plan.
APEX_ADMIN_EMAILS=

# ---- web origins -------------------------------------------------------------------------------
# Your public site address (link previews for shared /u/handle pages)
# APEX_PUBLIC_SITE_URL=https://apex-picks.web.app
# *.web.app, *.firebaseapp.com and localhost are allowed. Add custom domains here.
# APEX_ALLOWED_ORIGINS=https://apex.example.com
# Rate limits key on the caller's address. Only these proxies may report one for a client:
# fastly (Firebase Hosting's CDN) and google (Google load balancers). Add your own CIDRs if
# you put another proxy in front, e.g. fastly,google,203.0.113.0/24
# APEX_TRUSTED_PROXIES=fastly,google

# ---- AI ----------------------------------------------------------------------------------------
ANTHROPIC_MAX_TOKENS=16384
APEX_SYSTEM_PROMPT_MODE=mid
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_WEB_SEARCH=0

# ---- sportsbook prices (The Odds API) ----------------------------------------------------------
# Which leagues get every book's prices (default nfl; "all" for every league). The NBA, MLB,
# NHL and WNBA already carry DraftKings' prices from ESPN without a key.
# APEX_ODDS_SPORTS=nfl,nba,nhl
# Daily credit budgets, shared by every instance: each league's board prices (per league), and
# the analyzer's odds pages. Set them from your plan: monthly credits / 30, split between them.
# APEX_ODDS_DAILY_CREDITS=400
# APEX_ODDS_ANALYZER_DAILY_CREDITS=500
# Games whose odds nobody has opened yet today, per caller (opened ones are cached for all).
# APEX_ODDS_NEW_GAMES_PER_USER=6
# APEX_ODDS_NEW_GAMES_PER_IP=2

# ---- scale -------------------------------------------------------------------------------------
# Keep one instance warm on game days (costs money; removes cold starts).
# APEX_MIN_INSTANCES=1
# APEX_MAX_INSTANCES=10
# Live streams per instance (the rest of its 250 slots stay free for normal requests) and per
# caller. Past either, browsers poll every few seconds instead.
# APEX_MAX_STREAMS=180
# APEX_MAX_STREAMS_PER_IP=6
# Follow-up questions allowed on one game analysis.
# APEX_FOLLOWUPS_PER_ANALYSIS=10
