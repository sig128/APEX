# Copy to functions/.env (git-ignored). The Firebase CLI loads it on deploy.
# Secrets do NOT go here: use `firebase functions:secrets:set` for ANTHROPIC_API_KEY,
# ADMIN_SPORTS_KEY and THE_ODDS_API_KEY.

# ---- passes (USDC on Base) -------------------------------------------------------------------
# Your wallet on Base that receives payments. Leave empty to keep the paywall off.
APEX_TREASURY_ADDRESS=
# base (real money) or base-sepolia (test USDC)
APEX_BILLING_NETWORK=base
# Optional: your own RPC (Alchemy, QuickNode...). Defaults to the public Base endpoint.
# APEX_BASE_RPC_URL=
# APEX_PRICE_PRO_USD=29
# APEX_PRICE_ELITE_USD=79
# Daily AI allowances
# APEX_PRO_AI_READS_PER_DAY=15
# APEX_ELITE_AI_READS_PER_DAY=30
# APEX_PRO_ANALYSES_PER_DAY=8
# APEX_ELITE_ANALYSES_PER_DAY=15
# APEX_USAGE_TZ=America/New_York

# ---- admins ------------------------------------------------------------------------------------
# Google accounts (verified emails) that get the admin page, comps and every plan.
APEX_ADMIN_EMAILS=

# ---- web origins -------------------------------------------------------------------------------
# *.web.app, *.firebaseapp.com and localhost are allowed. Add custom domains here.
# APEX_ALLOWED_ORIGINS=https://apex.example.com
# Through a Hosting rewrite the client IP is 2 proxies back (used for rate limits).
APEX_TRUSTED_HOPS=2

# ---- AI ----------------------------------------------------------------------------------------
ANTHROPIC_MAX_TOKENS=16384
APEX_SYSTEM_PROMPT_MODE=mid
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_WEB_SEARCH=0

# ---- scale -------------------------------------------------------------------------------------
# Keep one instance warm on game days (costs money; removes cold starts).
# APEX_MIN_INSTANCES=1
# APEX_MAX_INSTANCES=10
