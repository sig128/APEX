# Copy to backend/.env (git-ignored). Loaded by `npm run dev` / `npm start` in backend/.

# ---- AI ----------------------------------------------------------------------------------------
# The AI behind prop reads, the parlay check, game intel and the analyzer. OpenAI answers when
# its key is set (https://platform.openai.com/api-keys), Anthropic otherwise.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6-sol            (per feature: OPENAI_INSIGHT_MODEL, OPENAI_PARLAY_MODEL, OPENAI_INTEL_MODEL)
# OPENAI_REASONING_EFFORT=low       (none | low | medium | high; "off" leaves it out)
# ANTHROPIC_API_KEY=                (https://console.anthropic.com/)
# ANTHROPIC_MODEL=claude-sonnet-5-5
APEX_AI_MAX_TOKENS=16384
# APEX_SYSTEM_PROMPT_MODE=compact   (compact | mid | full)
# APEX_WEB_SEARCH=0                 (turn off the analyzer's web search)

# ---- sign-in -----------------------------------------------------------------------------------
# Locally the API can run without Firebase credentials: sign-in is then optional and the AI is
# open. Anywhere else sign-in is always required.
APEX_AUTH=optional
# To verify real Google sign-ins locally, point this at a service account JSON (never commit it):
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# Admins: Google accounts (verified emails) that get the admin page and every plan.
APEX_ADMIN_EMAILS=
# Admin key for /adminn sport toggles and scripted admin calls (12+ random characters).
ADMIN_SPORTS_KEY=

# ---- passes (USDC on Base) -------------------------------------------------------------------
# Leave the treasury empty to keep the paywall off (everything open, invite codes gate the AI).
APEX_TREASURY_ADDRESS=
# base-sepolia = test USDC (try the whole flow for free first), base = real money
APEX_BILLING_NETWORK=base-sepolia
# APEX_BASE_RPC_URL=https://sepolia.base.org
# APEX_BILLING_CONFIRMATIONS=3
# APEX_PRICE_PRO_USD=29
# APEX_PRICE_ELITE_USD=79

# ---- data --------------------------------------------------------------------------------------
# The leagues on the site (all by default): nfl,nba,mlb,nhl,ncaaf,ncaab,wnba
# APEX_SPORTS=nfl,nba,mlb,nhl,ncaaf,ncaab,wnba
# Optional: The Odds API key adds sportsbook prices (and edges) to props. A backup key takes
# over when the first is refused or out of credits (several keys can also go in
# THE_ODDS_API_KEY, comma-separated, first one first).
# THE_ODDS_API_KEY=
# THE_ODDS_API_KEY_BACKUP=
# Which leagues get every book's prices from it (default nfl; "all" for every league). The NBA,
# MLB, NHL and WNBA already carry DraftKings' prices from ESPN without a key.
# APEX_ODDS_SPORTS=nfl,nba,nhl
# Daily credit budgets: each league's board prices, and the analyzer's odds pages.
# APEX_ODDS_DAILY_CREDITS=400
# APEX_ODDS_ANALYZER_DAILY_CREDITS=500
# Where the live data snapshot is kept locally (default backend/var/store).
# APEX_STORE=disk

# PORT=8787
