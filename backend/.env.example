# Copy this file to backend/.env and fill in values. .env is loaded automatically; this file is only a template.
# Get a key from https://console.anthropic.com/ — never commit real keys.

ANTHROPIC_API_KEY=

# Optional: model id (default used if unset)
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Max output tokens (~12k). Default 12288 if unset (matches Cloud Functions).
ANTHROPIC_MAX_TOKENS=16384

# System prompt size: default is compact unless you opt in.
# - compact (default): short sport-specific prompts (MLB/NHL/NBA/NFL).
# - mid: MLB-only mid-length prompt (`prompts/apexSystemPromptMlbMid.js`); other sports use compact.
# - full (or large/long/verbose): long-form prompts per sport.
# APEX_SYSTEM_PROMPT_MODE=compact
# APEX_SYSTEM_PROMPT_MODE=mid
# APEX_SYSTEM_PROMPT_MODE=full
#
# For Firebase Cloud Functions, mirror non-secret vars in `functions/.env` (see `functions/.env.example`).

# Web search tool (Anthropic server tool; enable in Claude Console → Privacy)
# Default: enabled. Set to 0 or false to disable (avoids per-search billing).
# ANTHROPIC_WEB_SEARCH=0
# Max web searches per Analyze / chat request (default 5; was 1 and caused “exhausted search calls” mid-run).
# Range 1–20. Set on Cloud Functions env for production if not using backend/.env copy.
# ANTHROPIC_WEB_SEARCH_MAX_USES=5

# Optional: port for local API (default 8787). If you see EADDRINUSE, either:
#   lsof -ti :8787 | xargs kill -9
#   or change PORT here and match frontend/vite.config.js server.proxy target.
# PORT=8787

# The Odds API (schedule search — https://the-odds-api.com/)
# THE_ODDS_API_KEY=
